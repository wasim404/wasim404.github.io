[Unit]
Description=MANOONG Node.js API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=manoong
Group=www-data
WorkingDirectory=/var/www/manoong/current
EnvironmentFile=/etc/manoong/manoong.env
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/manoong /var/lib/manoong/uploads/avatars

[Install]
WantedBy=multi-user.target
